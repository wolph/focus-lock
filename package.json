{
  "name": "focus-lock",
  "version": "0.1.1",
  "description": "Focus Lock: focus sessions that lock distracting sites, with earned site access credit.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run gen-locales && vite",
    "gen-icons": "node scripts/gen-icons.mjs",
    "gen-locales": "node scripts/gen-locales.mjs",
    "check-locales": "node scripts/check-locales.mjs",
    "build": "npm run gen-icons && npm run gen-locales && vite build",
    "build:store": "npm run gen-icons && npm run gen-locales && vite build --mode store",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "e2e": "npm run store:package && npm run pages:build && playwright test",
    "pages:build": "vite build --config vite.pages.config.ts && node scripts/build-pages.mjs",
    "pages:validate": "npm run pages:build && node scripts/validate-pages.mjs && html-validate 'dist-pages/**/*.html'",
    "qa:checklist": "node scripts/qa-checklist.mjs",
    "stats:dev-evidence": "STATS_DEV_EVIDENCE_DIR=artifacts/stats-task5/dev node --experimental-strip-types scripts/capture-stats-dev-evidence.ts",
    "stats:evidence": "STATS_EVIDENCE_DIR=artifacts/stats-task5/production playwright test tests/e2e/qa-flows.spec.ts -g \"Task 5 Stats responsive evidence matrix\"",
    "qa:validate": "node scripts/qa-checklist.mjs --check",
    "chrome:messages": "node scripts/verify-chrome-injection-errors.mjs",
    "store:validate": "node scripts/validate-store-package.mjs",
    "store:package": "npm run build:store && node scripts/validate-store-package.mjs --zip",
    "check": "biome check . && tsc --noEmit && npm run check-locales && vitest run && npm run build:store"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "preact": "^10.29.8",
    "tldts": "^7.4.11"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@biomejs/biome": "^2.5.11",
    "@crxjs/vite-plugin": "^2.7.1",
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.6",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/preact": "^3.2.4",
    "@types/chrome": "^0.2.7",
    "@types/pngjs": "^6.0.5",
    "css-tree": "^3.2.1",
    "html-validate": "^11.11.0",
    "jsdom": "^30.0.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
