  "options_privacy_confirm_local_history_body": {
    "message": "This permanently Sils full URLs, focus intentions, and detailed Seans events from this device. It does not clear a running Seans, which keeps its intention and the address of each tab it is blocking. Ending the Seans clears the intention and starts a cleanup that clears every open website tab, and the cleanup removes every stored address when it completes."
  },
  "options_privacy_confirm_local_history_body_aggregates": {
    "message": "This permanently Sils full URLs, focus intentions, and detailed Seans events from this device, plus local-only aggregate statistics. It does not clear a running Seans, which keeps its intention and the address of each tab it is blocking. Ending the Seans clears the intention and starts a cleanup that clears every open website tab, and the cleanup removes every stored address when it completes."
