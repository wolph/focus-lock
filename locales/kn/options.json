  },
  "options_privacy_local_history_deleted": {
    "message": "ಸ್ಥಳೀಯ ಇತಿಹಾಸ ಅಳಿಸಲಾಗಿದೆ."
  },
  "options_privacy_confirm_local_history_body": {
    "message": "ಇದು ಸ್ಥಳೀಯ ವಿವರಣಾತ್ಮಕ ಇತಿಹಾಸ, ನೋಟ್, ಆದೆಂದಕ್ಕೆ ಚೌಕಾಗಾರದ ಅಂತರಲೀನ ಖರೀದಿ ಮಾಡುವ ಯೋಜನೆಗಳನ್ನು ಈ ಸಾಧನದಿಂದ ಸ್ಥಾಯಿಯಾಗಿ ಅಳಿಸುತ್ತದೆ. ಇದು ನಿರೀಕ್ಷಿತ ಸೆಷನ್ ಅನ್ನು ತೆರವುಗೊಳಿಸುವುದಿಲ್ಲ, ಅದರೆ ಉದ್ದೇಶ ಮತ್ತು ಅದು ನಿರ್ಬಂಧ ಮಾಡುವ ಪ್ರತಿಯೊಂದು ಟ್ಯಾಬ್ ವಿಸ್ತಾರವನ್ನು ಇರಿಸುತ್ತದೆ. ಸೆಷನ್ ಸಮಾಪ್ತಿಯು ಉದ್ದೇಶ ತೆರವುಗೊಳಿಸುತ್ತದೆ ಮತ್ತು ಸಕಿವೌನ ವೆಬ್‍ಸೈಟ್ ಟ್ಯಾಬ್‍ಗಳನ್ನು ತೆರವುಗೊಳಿಸುವ ಸಿಕ್ವೇಷ್ಟ್ರಾನ್ ಆರಂಭ ಮಾಡುತ್ತದೆ, ಮತ್ತು ಆಯೋಗವು ಸಮಾಪ್ತಿಯಲ್ಲಿ ಪ್ರತಿಯೊಂದು ಶಿಲ್ಪಿ ವಿಸ್ತಾರ ತೆರವುಗೊಳಿಸುತ್ತದೆ."
  },
  "options_privacy_confirm_local_history_body_aggregates": {
    "message": "ಇದು ಪೂರ್ಣ URLs, ಫೋಕಸ್ ಉದ್ದೇಶಗಳು ಮತ್ತು ವಿವರಣಾತ್ಮಕ ಸೆಷನ್ ಇವೆಂಟ್‍ಗಳನ್ನು ಈ ಸಾಧನದಿಂದ ಮತ್ತು ಮಿಶ್ರಣ-ಮಾತ್ರ ಒಟ್ಟುಗೊಳಿಸುವ ಸಂಖ್ಯೆಗಳನ್ನು ಸ್ಥಾಯಿಯಾಗಿ ಅಳಿಸುತ್ತದೆ. ಇದು ನಿರೆಕ್ಷಿತ ಸೆಷನ್ ಅನ್ನು ತೆರವುಗೊಳಿಸುವುದಿಲ್ಲ, ಆದೆ ಉದ್ದೇಶ ಮತ್ತು ಅದು ನಿರ್ಬಂಧ ಮಾಡುವ ಪ್ರತಿಯೊಂದು ಟ್ಯಾಬ್ ವಿಸ್ತಾರವನ್ನು ಇರಿಸುತ್ತದೆ. ಸೆಷನ್ ಸಮಾಪ್ತಿ ಉದ್ದೇಶ ತೆರವುಗೊಳಿಸುತ್ತದೆ ಮತ್ತು ಸಕ್ರಿಯ ವೆಬ್‍ಸೈಟ್ ಟ್ಯಾಬ್‍ಗಳನ್ನು ತೆರವುಗೊಳಿಸುವ ಪ್ರಕ್ರಿಯೆ ಆರಂಭ ಮಾಡುತ್ತದೆ, ಮತ್ತು ಪ್ರಕ್ರಿಯೆ ಸಮಾಪ್ತಿಯಲ್ಲಿ ಪ್ರತಿಯೊಂದು ಶಿಲ್ಪಿ ವಿಸ್ತಾರ ತೆರವುಗೊಳಿಸುತ್ತದೆ."
  },
